  "dm_enable_discount_label": "ಈ ರಿಯಾಯಿತಿಯನ್ನು ಸಕ್ರಿಯಗೊಳಿಸಿ",
  "dm_enable_discount_desc": "ನೀವು ಸೇವ್ ಮಾಡಿದ ತಕ್ಷಣ ಗ್ರಾಹಕ ಆ್ಯಪ್‌ನಲ್ಲಿ ಲೈವ್ ಆಗುತ್ತದೆ",
  "dm_save_changes": "ಬದಲಾವಣೆಗಳನ್ನು ಉಳಿಸಿ",
  "dm_know_more_title": "ರಿಯಾಯಿತಿ ನಿರ್ವಹಣೆ ಹೇಗೆ ಕಾರ್ಯನಿರ್ವಹಿಸುತ್ತದೆ",
  "dm_step1_title": "ಆಫರ್ ರಚಿಸಿ",
  "dm_step1_text": "ಮಾರ್ಗದರ್ಶಿತ ಫಾರ್ಮ್‌ಗಾಗಿ ರಿಯಾಯಿತಿ ರಚಿಸಿ ಟ್ಯಾಪ್ ಮಾಡಿ, ಅಥವಾ ಸ್ವತಂತ್ರವಾಗಿ ನಿರ್ಮಿಸಲು ಕಸ್ಟಮ್ ರಿಯಾಯಿತಿ ಆಯ್ಕೆಮಾಡಿ. ಶೀರ್ಷಿಕೆ, ನಿಜವಾದ ಫೋಟೋ ಮತ್ತು ವಿವರಣೆ ಸೇರಿಸಿ — ಗ್ರಾಹಕರು ಇವೆಲ್ಲವನ್ನೂ ಆಫರ್‌ಗಳ ಪುಟದಲ್ಲಿ ನೋಡುತ್ತಾರೆ.",
  "dm_step2_title": "ಇದು ಯಾವುದಕ್ಕೆ ಅನ್ವಯಿಸುತ್ತದೆ ಎಂದು ಆಯ್ಕೆಮಾಡಿ",
  "dm_step2_text": "ನಿರ್ದಿಷ್ಟ ಐಟಂಗಳು, ಸಂಪೂರ್ಣ ವರ್ಗ, ನಿಗದಿತ ಬೆಲೆಯಲ್ಲಿ 2+ ಐಟಂಗಳ ಕಾಂಬೊ, ಅಥವಾ ಇಡೀ ಆರ್ಡರ್ (ಸ್ಟೋರ್‌ವೈಡ್, ಐಚ್ಛಿಕ ಕನಿಷ್ಠ ಕಾರ್ಟ್ ಮೌಲ್ಯದೊಂದಿಗೆ).",
  "dm_step3_title": "ಮೌಲ್ಯ ಮತ್ತು ವೇಳಾಪಟ್ಟಿಯನ್ನು ಹೊಂದಿಸಿ",
  "dm_step3_text": "ಶೇಕಡಾ ರಿಯಾಯಿತಿ, ಫ್ಲಾಟ್ ಮೊತ್ತ ರಿಯಾಯಿತಿ, ಅಥವಾ ನಿಗದಿತ ಕಾಂಬೊ ಬೆಲೆ. ಐಚ್ಛಿಕವಾಗಿ ಇದನ್ನು ದಿನಾಂಕ ಶ್ರೇಣಿ, ಸಮಯ ವಿಂಡೋ (ಉದಾ. 4–7pm ಹ್ಯಾಪಿ ಅವರ್) ಮತ್ತು ವಾರದ ನಿರ್ದಿಷ್ಟ ದಿನಗಳಿಗೆ ಸೀಮಿತಗೊಳಿಸಿ.",
  "dm_step4_title": "ಇದು ತಕ್ಷಣ ಲೈವ್ ಆಗುತ್ತದೆ",
  "dm_step4_text": "ನೀವು ಸೇವ್ ಮಾಡಿದ ಕ್ಷಣ (ಅಥವಾ Live/Off ಟಾಗಲ್ ಮಾಡಿದಾಗ), ಬದಲಾವಣೆಯು ಪ್ರತಿ ಗ್ರಾಹಕರ ಆ್ಯಪ್ ಮತ್ತು ನಿಮ್ಮ ಡ್ಯಾಶ್‌ಬೋರ್ಡ್‌ಗೆ ಲೈವ್ ಸಂಪರ್ಕದ ಮೂಲಕ ತಕ್ಷಣ ತಲುಪುತ್ತದೆ — ರಿಫ್ರೆಶ್ ಅಗತ್ಯವಿಲ್ಲ.",
  "dm_step5_title": "ರಿಯಾಯಿತಿಗಳು ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಅನ್ವಯಿಸುತ್ತವೆ",
  "dm_step5_text": "ಗ್ರಾಹಕರ ಕಾರ್ಟ್ ಲೈವ್ ಆಫರ್‌ಗೆ ಹೊಂದಿಕೆಯಾದಾಗ, ಚೆಕ್‌ಔಟ್‌ನಲ್ಲಿ ರಿಯಾಯಿತಿ ಬೆಲೆಯನ್ನು ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಲೆಕ್ಕಹಾಕಲಾಗುತ್ತದೆ — ಐಟಂ, ವರ್ಗ, ಕಾಂಬೊ ಮತ್ತು ಸ್ಟೋರ್‌ವೈಡ್ ಆಫರ್‌ಗಳು ಎಲ್ಲಾ ಸರಿಯಾಗಿ ಸೇರುತ್ತವೆ.",
  "dm_step6_title": "ಯಾವಾಗ ಬೇಕಾದರೂ ನಿರ್ವಹಿಸಿ",
  "dm_step6_text": "ವಿವರಗಳನ್ನು ಬದಲಾಯಿಸಲು ಪೆನ್ಸಿಲ್ ಐಕಾನ್ ಟ್ಯಾಪ್ ಮಾಡಿ, ಆಫರ್ ಕಳೆದುಕೊಳ್ಳದೆ ವಿರಾಮಗೊಳಿಸಲು Live/Off ಟಾಗಲ್ ಮಾಡಿ, ಅಥವಾ ಟ್ರ್ಯಾಶ್ ಐಕಾನ್‌ನೊಂದಿಗೆ ಶಾಶ್ವತವಾಗಿ ಅಳಿಸಿ. ಅವಧಿ ಮುಗಿದ ಅಥವಾ ಶೆಡ್ಯೂಲ್ ಆಗಿರುವ ಆಫರ್‌ಗಳನ್ನು ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಲೇಬಲ್ ಮಾಡಲಾಗುತ್ತದೆ.",
  "dm_tip": "ಸಲಹೆ: ಪ್ರತಿ ಆಫರ್‌ಗೆ ನಿಜವಾದ ಫೋಟೋ ಸೇರಿಸಿ — ಫೋಟೋಗಳಿರುವ ಆಫರ್‌ಗಳು ಸಾದಾ ಪಠ್ಯ ಬ್ಯಾನರ್‌ಗಳಿಗಿಂತ ಗ್ರಾಹಕ ಆ್ಯಪ್‌ನಲ್ಲಿ ಹೆಚ್ಚು ಟ್ಯಾಪ್‌ಗಳನ್ನು ಪಡೆಯುತ್ತವೆ.",
